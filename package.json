{
  "name": "sous",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @sous/web --",
    "build": "npm run build -w @sous/web --",
    "lint": "npm run lint -w @sous/web --",
    "typecheck": "npm run typecheck -w @sous/web --",
    "test": "npm run test -w @sous/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "node --test 'supabase/tests/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.9"
  }
}
