# Copy to .env.local. Only VITE_-prefixed vars are exposed to the browser,
# so never put secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PostHog (usage, errors, session replays; off when empty). The project key is public.
VITE_POSTHOG_KEY=
# "on" once Google is set up in Supabase (TYL-48): shows "Continue with Google".
VITE_GOOGLE_SIGN_IN=
