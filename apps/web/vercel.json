{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sous-api-five.vercel.app/api/:path*"
    },
    {
      "source": "/(share|new|settings)",
      "destination": "/"
    },
    {
      "source": "/(recipe|edit)/:id",
      "destination": "/"
    }
  ]
}
